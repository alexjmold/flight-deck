{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "jsx": "react-jsx",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    // tsup emits dist/; tsc is only here to typecheck.
    "noEmit": true
  },
  "include": ["src", "tsup.config.ts"]
}
